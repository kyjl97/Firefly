---
import type { MarkdownHeading } from "astro";

import CategoryList from "./CategoryList.astro";
import Profile from "./Profile.astro";
import TagList from "./TagList.astro";
import TOC from "./TOC.astro";
import VideoDecoration from "./VideoDecoration.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const { headings = [] } = Astro.props;
const isPostsRoute = Astro.url.pathname.startsWith("/posts/");
---
<div id="sidebar" class:list={[className, "w-full"]}>
    {!isPostsRoute && (
        <div class="flex flex-col w-full gap-4 mb-4">
            <Profile></Profile>
            <VideoDecoration></VideoDecoration>
            <CategoryList></CategoryList>
            <TagList></TagList>
        </div>
    )}
    {isPostsRoute && (
        <div id="sidebar-sticky" class="transition-all duration-700 sticky top-4 w-full">
            <div id="toc-inner-wrapper" class="max-h-[calc(100vh_-_2rem)] overflow-y-auto overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full">
                    <TOC headings={headings} />
                </div>
            </div>
        </div>
    )}
</div>
