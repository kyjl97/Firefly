---
/**
 * 标签列表组件
 * 五彩萤火虫 - 深黑背景，微弱毛玻璃，中心向外扩散
 */
import { getCollection } from "astro:content";

// 获取所有文章并统计标签
const allPosts = await getCollection("posts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

// 统计每个标签的文章数量
const tagCount = new Map<string, number>();
for (const post of allPosts) {
	const tags = post.data.tags || [];
	for (const tag of tags) {
		tagCount.set(tag, (tagCount.get(tag) || 0) + 1);
	}
}

// 获取标签
const tags = Array.from(tagCount.entries())
	.map(([name, count]) => ({ name, count }))
	.sort((a, b) => b.count - a.count)
	.slice(0, 16);

// 为每个标签生成从中心向外扩散的动画参数
const fireflyTags = tags.map((tag, index) => {
	// 从中心向外散开的角度
	const angle = (index / tags.length) * Math.PI * 2;
	// 起始位置在中心附近
	const startX = Math.cos(angle) * 5;
	const startY = Math.sin(angle) * 5;
	// 向外扩散的目标位置
	const floatX = Math.cos(angle) * (50 + Math.random() * 30);
	const floatY = Math.sin(angle) * (40 + Math.random() * 25);

	return {
		...tag,
		startX,
		startY,
		floatX,
		floatY,
		delay: Math.random() * 2,
		duration: 4 + Math.random() * 3,
		// 每个标签不同的颜色
		hue: (index * 30) % 360,
	};
});
---

<div class="firefly-container">
    <div class="tech-bg">
        <!-- 科技网格 -->
        <div class="tech-grid"></div>
        <!-- 中心光晕 -->
        <div class="center-glow"></div>
    </div>
    
    <!-- 萤火虫标签 -->
    {fireflyTags.map((tag, index) => (
        <a 
            href={`/tags/${tag.name}/`}
            class="firefly"
            style={`
                --start-x: ${tag.startX}px; 
                --start-y: ${tag.startY}px;
                --float-x: ${tag.floatX}px;
                --float-y: ${tag.floatY}px;
                --delay: ${tag.delay}s;
                --duration: ${tag.duration}s;
                --hue: ${tag.hue};
            `}
        >
            <span class="firefly-glow"></span>
            <span class="firefly-text">{tag.name}</span>
        </a>
    ))}
</div>

<style>
    .firefly-container {
        width: 100%;
        height: 240px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
        /* 暖色深棕背景，配合 Kami 主题 */
        background: linear-gradient(135deg, #2a2520, #1e1a16);
        border-radius: 12px;
    }

    /* 科技网格 */
    .tech-grid {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image:
            linear-gradient(rgba(200, 180, 150, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(200, 180, 150, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        pointer-events: none;
    }

    /* 中心光晕 */
    .center-glow {
        position: absolute;
        width: 80px;
        height: 80px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle,
            rgba(200, 170, 120, 0.1) 0%,
            transparent 70%
        );
        animation: centerPulse 5s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes centerPulse {
        0%, 100% { opacity: 0.4; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.2); }
    }

    /* 萤火虫 - 从中心向外扩散 */
    .firefly {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        white-space: nowrap;
        animation: 
            fireflySpread var(--duration) ease-in-out infinite,
            fireflyGlow 2s ease-in-out infinite;
        animation-delay: var(--delay), var(--delay);
        z-index: 10;
    }

    /* 从中心向外扩散的动画 */
    @keyframes fireflySpread {
        0% {
            transform: translate(-50%, -50%) translate(0px, 0px);
        }
        50% {
            transform: translate(-50%, -50%) translate(var(--float-x), var(--float-y));
        }
        100% {
            transform: translate(-50%, -50%) translate(0px, 0px);
        }
    }

    @keyframes fireflyGlow {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }

    /* 彩色光晕 */
    .firefly-glow {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: hsl(var(--hue), 90%, 60%);
        box-shadow: 
            0 0 6px hsl(var(--hue), 90%, 60%),
            0 0 12px hsl(var(--hue), 80%, 50%);
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { 
            transform: scale(0.85);
            box-shadow: 
                0 0 4px hsl(var(--hue), 90%, 60%),
                0 0 8px hsl(var(--hue), 80%, 50%);
        }
        50% { 
            transform: scale(1.2);
            box-shadow: 
                0 0 8px hsl(var(--hue), 90%, 60%),
                0 0 16px hsl(var(--hue), 80%, 50%);
        }
    }

    /* 五颜六色渐变文字 + 霓虹发光 */
    .firefly-text {
        position: relative;
        z-index: 1;
        font-size: 11px;
        font-weight: 500;
        font-family: 'Consolas', 'Courier New', monospace;
        /* 渐变文字 */
        background: linear-gradient(90deg,
            hsl(var(--hue), 90%, 70%),
            hsl(calc(var(--hue) + 40), 90%, 65%),
            hsl(calc(var(--hue) + 80), 90%, 70%)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        /* 霓虹发光效果 */
        filter: drop-shadow(0 0 3px hsl(var(--hue), 90%, 60%))
                drop-shadow(0 0 6px hsl(var(--hue), 80%, 50%));
        padding: 2px 5px;
        background-color: rgba(40, 35, 28, 0.4);
        border-radius: 3px;
    }

    /* Hover效果 */
    .firefly:hover {
        z-index: 100;
        animation-play-state: paused;
    }

    .firefly:hover .firefly-glow {
        animation: none;
        transform: scale(1.8);
    }

    .firefly:hover .firefly-text {
        -webkit-text-fill-color: hsl(var(--hue), 100%, 80%);
        background: transparent;
        filter: drop-shadow(0 0 6px hsl(var(--hue), 100%, 70%))
                drop-shadow(0 0 12px hsl(var(--hue), 90%, 60%));
        transform: scale(1.15);
    }
</style>